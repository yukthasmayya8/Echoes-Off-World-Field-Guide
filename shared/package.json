{
  "name": "@echoes/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared data contracts, Zod schemas and pure catalog helpers for Echoes.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
